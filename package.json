{
  "name": "zafu-pchospital-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "浙江农林大学电脑医院 · 社团综合服务平台官网",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "postinstall": "prisma generate && node tools/ensure-doc-manifest.mjs",
    "predev": "node tools/ensure-doc-manifest.mjs",
    "dev": "next dev",
    "build": "node tools/build-docs.mjs && next build",
    "prebuild:site": "node tools/ensure-doc-manifest.mjs",
    "build:site": "next build",
    "docs:build": "node tools/build-docs.mjs",
    "start": "next start",
    "lint": "eslint . && node tools/check-theme-palette.mjs",
    "check:palette": "node tools/check-theme-palette.mjs",
    "table:capabilities": "tsx tools/generate-table-capabilities.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:health": "tsx tools/db-health.ts",
    "import:repair-history": "tsx --env-file=.env tools/import-repair-history.ts",
    "email:notify": "tsx --env-file=.env tools/account-notifications.ts",
    "email:cleanup": "tsx --env-file=.env tools/email-cleanup.ts",
    "retire:repair-drafts": "tsx --env-file=.env tools/retire-repair-drafts.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:db": "tsx --env-file=.env --test --test-concurrency=1 tests/integration/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "8.21.3",
    "exceljs": "^4.4.0",
    "mariadb": "3.5.4",
    "next": "^15.5.28",
    "nodemailer": "10.1.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.13",
    "tsx": "4.20.6",
    "typescript": "^5.8.3"
  }
}
