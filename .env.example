# Copy this file to .env for local CLI/scripts. Never commit real secrets.
# Matches compose.greatsql.wsl.yml for local development; use separate credentials elsewhere.
# GreatSQL 8.0.32-27 / InnoDB / utf8mb4_unicode_ci / UTC.
#
# allowPublicKeyRetrieval 默认关闭。仅当 MySQL 8+/9 使用 caching_sha2_password
# 且**未启用 TLS** 时，本地开发才需要显式追加 `?allowPublicKeyRetrieval=true`
# （否则报 SQLState 08S01 "RSA public key is not available client side"）。
# 生产必须改用 TLS，不要打开该开关。
DATABASE_URL=mysql://app_user:change-me@127.0.0.1:3307/zafu_pchospital

# Application and authentication
AUTH_SECRET=replace-with-at-least-32-random-bytes
# Also the CSRF allowlist: write endpoints require an Origin equal to this base URL
# (or its www variant). Any extra public hostname must be reflected here too.
APP_BASE_URL=http://localhost:3000
# Server-authoritative stable identifier, not a client-provided display name.
RECRUITMENT_CYCLE=2026-autumn

# Deterministic sensitive digests; use independent random values per environment.
INVITE_CODE_PEPPER=replace-with-random-secret-at-least-32-bytes
PII_AUDIT_PEPPER=replace-with-random-secret-at-least-32-bytes

# Server-only repair photo storage. Production must mount a persistent shared volume.
UPLOAD_PATH=./storage/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_REPAIR=9

# 邮箱验证码 / 密码找回（issue #146）。默认关闭：未启用不影响应用启动，
# 邮件操作在服务层被明确拒绝（EMAIL_NOT_ENABLED），不会伪装发送成功。
# 开启后 SMTP_HOST / SMTP_USER / SMTP_PASSWORD / MAIL_FROM / EMAIL_CODE_PEPPER 缺一不可。
MAIL_ENABLED=false
# 阿里云 DirectMail 触发邮件：465 隐式 TLS（生产 ECS 的 25 / 587 出站被封）。
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=浙江农林大学电脑医院 <noreply@pczafu.cn>
# 验证码 / 重置令牌的 HMAC 独立密钥：至少 32 个随机字节，与其它 pepper 分开。
EMAIL_CODE_PEPPER=
# 全站每日发信预算（正整数，缺省 150）。生产配置须不高于服务商实际可用额度。
EMAIL_DAILY_BUDGET=150
# 统一账号门禁档位（issue #146 任务 6，仅服务端；不用 NEXT_PUBLIC / 请求参数 / 前端存储）。
#   off   缺省：不强制邮箱验证（既有强制改密仍生效，可主动绑定 / 找回）
#   admin 当次具有 ADMIN 角色的账号必须已验证邮箱或持有效豁免（双角色访问 /member 同样受限）
#   all   全部已认证账号同口径
# 非法值启动即失败（EMAIL_GATE_MODE_INVALID），不会静默退回 off；改值须按部署方式重启所有实例。
# 上线顺序与回退见 docs/email-gate-rollout.md。
EMAIL_GATE_MODE=off
# Optional management integration; absent values keep dedicated machine endpoints disabled.
# Store only the SHA-256 digest here. Never reuse AUTH_SECRET or a browser Session.
MANAGEMENT_BOT_TOKEN_SHA256=
MANAGEMENT_BOT_TOKEN_EXPIRES_AT=
MANAGEMENT_BOT_ORIGIN=

# 前端遥测（issue #380）。前两项构建期内联，改动后需重新构建；
# TELEMETRY_DISABLED 是服务端接收开关，停止接收时返回 202 但不读正文、不写日志。
# NEXT_PUBLIC_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_TELEMETRY_SAMPLE_RATE=0.1
# TELEMETRY_DISABLED=1
