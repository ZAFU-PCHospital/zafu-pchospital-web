# Copy this file to .env for local CLI/scripts. Never commit real secrets.
# Matches compose.greatsql.yml only; use separate credentials and databases elsewhere.
# GreatSQL 8.0.32-27 / InnoDB / utf8mb4_unicode_ci / UTC.
DATABASE_URL=mysql://app_user:change-me@127.0.0.1:3307/zafu_pchospital

# Application and authentication
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_BASE_URL=http://localhost:3000
# Server-authoritative stable identifier, not a client-provided display name.
RECRUITMENT_CYCLE=2026-autumn

# Deterministic sensitive digests; use independent random values per environment.
INVITE_CODE_PEPPER=replace-with-random-secret-at-least-32-bytes
PII_AUDIT_PEPPER=replace-with-random-secret-at-least-32-bytes

# Reserved server-only upload contract for later Phase 2 modules.
UPLOAD_PATH=./storage/uploads
UPLOAD_MAX_BYTES=10485760
