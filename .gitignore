# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# 站内技术文档：文档源码检出与构建产物，都由 pnpm docs:build 管理，不进仓库
/.docs-source/
/public/handbook/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo

# editors
.idea
.vscode/*
!.vscode/extensions.json

# 本地验证用的临时 Chrome 配置目录（tools/inspect.mjs）
.chrome-profile/

# 本地 Agent 工具的临时工作区（浏览器用户数据、截图脚本等），不属于仓库内容
.codex-tmp/

# 历史图库已退役；验证截图放仓库外，README 预览仅保留在 docs/assets/
/shots/

# 图集原图备份（tools/compress-gallery.mjs 自动生成，仅供重新导出用）
public/gallery/_originals/
public/_originals/

# 本地 Agent 工作区（记忆日志等，不随代码库共享）
.workbuddy/

# 文档清单文件
/src/data/doc-manifest.json

# Prisma 7 client is generated by postinstall / db:generate
/src/generated/prisma/

# M2 本地维修照片存储（生产使用持久化共享卷）
/storage/

# E2E（Playwright）运行产物：截图、trace、HTML 报告与夹具清单
/tests/e2e/.artifacts/
/tests/e2e/.report/

# 本机部署通知记录与私密凭证（凭证通过 WHALE_NOTIFY_CONFIG 指定）
/.runtime/deploy-notifications/
DEPLOY_NOTIFY.private.json
*.deploy-notify.private.json
__pycache__/
