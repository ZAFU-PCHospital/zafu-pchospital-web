  @@index([deletedAt, activityAt], map: "repair_activities_deleted_activity_idx")
  @@index([signupOpensAt, signupClosesAt], map: "repair_activities_signup_window_idx")
  @@map("repair_activities")
}

/// 客户报名。同活动同手机号仅一条有效报名（应用层 + 事务内查重）。
model RepairActivityRegistration {
  id                      String         @id @db.Char(36)
  activityId              String         @map("activity_id") @db.Char(36)
  name                    String         @db.VarChar(40)
  phone                   String         @db.VarChar(11)
  phoneLast4              String         @map("phone_last4") @db.VarChar(4)
  issueType               String         @map("issue_type") @db.VarChar(32)
  /// 机型（issue #68）：选填，接待落单时带进维修记录。
  deviceModel             String?        @map("device_model") @db.VarChar(60)
  status                  String         @db.VarChar(32)
  /// 报名时同意的免责声明版本与时间（issue #62 前端3）。历史报名没有签署动作，因此可空。
  consentVersion          String?        @map("consent_version") @db.VarChar(16)
  consentAcceptedAt       DateTime?      @map("consent_accepted_at") @db.DateTime(3)
  checkedInAt             DateTime?      @map("checked_in_at") @db.DateTime(3)
  servedAt                DateTime?      @map("served_at") @db.DateTime(3)
  servedByMemberProfileId String?        @map("served_by_member_profile_id") @db.Char(36)
  repairRecordId          String?        @unique(map: "repair_activity_regs_repair_record_uq") @map("repair_record_id") @db.Char(36)
  createdAt               DateTime       @map("created_at") @db.DateTime(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt               DateTime?      @map("deleted_at") @db.DateTime(3)
  activity                RepairActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  servedBy                MemberProfile? @relation("RepairActivityServedBy", fields: [servedByMemberProfileId], references: [id], onDelete: Restrict)
  repairRecord            RepairRecord?  @relation(fields: [repairRecordId], references: [id], onDelete: Restrict)
  noShowEvent             RepairActivityNoShowEvent?

  @@index([activityId, phone], map: "repair_activity_regs_activity_phone_idx")
  @@index([activityId, status, checkedInAt], map: "repair_activity_regs_activity_status_checked_idx")
  @@index([activityId, deletedAt], map: "repair_activity_regs_activity_deleted_idx")
  @@index([phone, status, activityId], map: "repair_activity_regs_phone_status_idx")
  @@map("repair_activity_registrations")
}

/// 成员本场出勤。无出勤不可签到客户 / 不可接待。
model RepairActivityAttendance {
  id              String         @id @db.Char(36)
  activityId      String         @map("activity_id") @db.Char(36)
  memberProfileId String         @map("member_profile_id") @db.Char(36)
  checkedInAt     DateTime       @map("checked_in_at") @db.DateTime(3)
  activity        RepairActivity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  memberProfile   MemberProfile  @relation(fields: [memberProfileId], references: [id], onDelete: Restrict)

  @@unique([activityId, memberProfileId], map: "repair_activity_attendance_activity_member_uq")
  @@index([memberProfileId], map: "repair_activity_attendance_member_idx")
  @@map("repair_activity_attendances")
}

/// 客户未到场事件（issue #335）：一个报名最多一条，保存报名时的姓名/手机快照。
/// 只有活动上海自然日结束、报名仍为 REGISTERED（未签到）时才生成；
/// 管理员的豁免只改事件状态，不删除历史。
model RepairActivityNoShowEvent {
  id               String   @id @db.Char(36)
  registrationId   String   @unique(map: "repair_activity_no_show_events_registration_uq") @map("registration_id") @db.Char(36)
  activityId       String   @map("activity_id") @db.Char(36)
  name             String   @db.VarChar(40)
  nameNormalized   String   @map("name_normalized") @db.VarChar(80)
  phone            String   @db.VarChar(11)
  phoneLast4       String   @map("phone_last4") @db.VarChar(4)
  /// CANDIDATE / CONFIRMED / EXCUSED；当前自动检测直接写 CONFIRMED，保留 CANDIDATE 供人工复核扩展。
  state            String   @db.VarChar(16)
  /// AUTO / HISTORICAL / MANUAL
  source           String   @db.VarChar(16)
  detectedAt       DateTime @map("detected_at") @db.DateTime(3)
  confirmedAt      DateTime? @map("confirmed_at") @db.DateTime(3)
  excusedAt        DateTime? @map("excused_at") @db.DateTime(3)
  excusedByUserId  String?  @map("excused_by_user_id") @db.Char(36)
  note             String?  @db.VarChar(500)
  createdAt        DateTime @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  registration RepairActivityRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  activity     RepairActivity              @relation(fields: [activityId], references: [id], onDelete: Restrict)
  excusedBy    User?                       @relation("RepairActivityNoShowExcusedBy", fields: [excusedByUserId], references: [id], onDelete: Restrict)

  @@index([nameNormalized, phone, state], map: "repair_activity_no_show_customer_state_idx")
  @@index([activityId, state], map: "repair_activity_no_show_activity_state_idx")
  @@map("repair_activity_no_show_events")
}

/// 客户封锁（issue #335）：按规范化姓名+手机号唯一，不关联成员/用户身份。
/// 自动封锁封到本学年结束；管理员可人工加入、解除或豁免事件，全部写审计。
model RepairActivityCustomerBlock {
  id                 String    @id @db.Char(36)
  name               String    @db.VarChar(40)
  nameNormalized     String    @map("name_normalized") @db.VarChar(80)
  phone              String    @db.VarChar(11)
  phoneLast4         String    @map("phone_last4") @db.VarChar(4)
  reason             String    @db.VarChar(500)
  /// AUTO / MANUAL
  source             String    @db.VarChar(16)
  /// 本学年结束时刻（Asia/Shanghai 次年 9/1 00:00 对应的 UTC）。
  blockedUntil       DateTime  @map("blocked_until") @db.DateTime(3)
  liftedAt           DateTime? @map("lifted_at") @db.DateTime(3)
  liftedByUserId     String?   @map("lifted_by_user_id") @db.Char(36)
  liftedReason       String?   @map("lifted_reason") @db.VarChar(500)
  createdByUserId    String?   @map("created_by_user_id") @db.Char(36)
  createdAt          DateTime  @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  createdBy User? @relation("RepairActivityCustomerBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  liftedBy  User? @relation("RepairActivityCustomerBlockLiftedBy", fields: [liftedByUserId], references: [id], onDelete: Restrict)

  @@unique([nameNormalized, phone], map: "repair_activity_customer_blocks_customer_uq")
  @@index([blockedUntil, liftedAt], map: "repair_activity_customer_blocks_status_idx")
  @@map("repair_activity_customer_blocks")
}

/// 邮箱验证码挑战（issue #146）。只存带独立密钥的 HMAC 摘要，明文验证码
/// 只在生成它的进程内存里存在过；验证码与「是否已验证」分表存放 ——
/// 待验证地址只放这里，不写 `user_identities`。
///
/// 状态机：`PENDING`（已预占额度、等待发信结果）→ `ACTIVE`（服务商已接受，可验证）；
/// `ACTIVE` → `CONSUMED`（成功消费，同一挑战最多一次）；任何未终结挑战被
/// 同一（用户, 用途）的新签发替代时 → `INVALIDATED`。过期由 `expires_at` 派生，
/// 不落存储态；`PENDING` 过期行不可验证、由清理收走，不恢复发送。
model EmailChallenge {
  id                    String    @id @db.Char(36)
  userId                String    @map("user_id") @db.Char(36)
  purpose               String    @db.VarChar(32)
  /// 发信目标（规范化邮箱）。待验证的新邮箱只存在于挑战行，不冒充已绑定身份。
  targetEmailNormalized String    @map("target_email_normalized") @db.VarChar(191)
  /// 目标为「当前有效邮箱」的用途（CHANGE_OLD / PASSWORD_RESET）在签发时快照身份 ID，
  /// 兑换重置授权时复核仍是同一身份；绑定 / 换新邮箱为 NULL。
  emailIdentityId       String?   @map("email_identity_id") @db.Char(36)
  /// PASSWORD_RESET 在签发时快照的凭据代次：管理员重置推进代次后，
  /// 旧验证码不得再兑换成新一代授权。其它用途为 NULL。
  credentialVersion     Int?      @map("credential_version")
  codeDigest            Bytes     @map("code_digest") @db.Binary(32)
  status                String    @db.VarChar(32)
  expiresAt             DateTime  @map("expires_at") @db.DateTime(3)
  /// 终结时刻（CONSUMED / INVALIDATED）；清理按 finished_at 判保留期。
  finishedAt            DateTime? @map("finished_at") @db.DateTime(3)
  createdAt             DateTime  @map("created_at") @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailIdentity         UserIdentity? @relation("EmailChallengeIdentity", fields: [emailIdentityId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, status], map: "email_challenges_user_purpose_status_idx")
  @@index([status, expiresAt], map: "email_challenges_status_expires_idx")
  @@index([finishedAt], map: "email_challenges_finished_idx")
  @@map("email_challenges")
}

/// 邮箱安全计数 / 预算桶（issue #146）。持久化、跨进程 / 重启生效：
/// 账号 / 目标 / IP 纬度的发信冷却与每日上限、验证失败与阻断、IP 校验请求、
/// 全站每日与每分钟预算共用这一张表，靠带用途命名空间的不可逆键摘要区分
/// （明文键不落库）。窗口为固定窗口：滚动类锚定首次事件，日类锚定上海自然日。
model EmailSecurityCounter {
  bucketKeyDigest Bytes     @id @map("bucket_key_digest") @db.Binary(32)
  counter         Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.DateTime(3)
  windowExpiresAt DateTime  @map("window_expires_at") @db.DateTime(3)
  /// 仅验证失败桶使用：达到失败上限后的阻断截止时刻。
  blockedUntil    DateTime? @map("blocked_until") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([windowExpiresAt, blockedUntil], map: "email_security_counters_window_blocked_idx")
  @@map("email_security_counters")
}

/// 一次性密码重置授权（issue #146）。只存令牌摘要；明文只在签发响应里出现一次。
/// 签发时保存账号与邮件身份资格快照（用户 / 身份 / 规范化邮箱 / 凭据代次 / 期限），
/// 兑换授权时逐项复核 —— 管理员重置推进代次后，旧授权自动失效。
model PasswordResetAuthorization {
  id                String    @id @db.Char(36)
  userId            String    @map("user_id") @db.Char(36)
  emailIdentityId   String    @map("email_identity_id") @db.Char(36)
  emailNormalized   String    @map("email_normalized") @db.VarChar(191)
  credentialVersion Int?      @map("credential_version")
  tokenDigest       Bytes     @unique(map: "password_reset_authorizations_token_uq") @map("token_digest") @db.Binary(32)
  status            String    @db.VarChar(32)
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  finishedAt        DateTime? @map("finished_at") @db.DateTime(3)
  createdAt         DateTime  @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailIdentity     UserIdentity @relation("PasswordResetAuthorizationIdentity", fields: [emailIdentityId], references: [id], onDelete: Restrict)

  @@index([userId, status], map: "pwd_reset_auth_user_status_idx")
  @@index([status, expiresAt], map: "pwd_reset_auth_status_expires_idx")
  @@index([finishedAt], map: "pwd_reset_auth_finished_idx")
  @@map("password_reset_authorizations")
}

model EmailAssistance {
  id String @id @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  targetEmailNormalized String @map("target_email_normalized") @db.VarChar(191)
  oldEmailIdentityId String? @map("old_email_identity_id") @db.Char(36)
  credentialVersion Int @map("credential_version")
  createdByUserId String @map("created_by_user_id") @db.Char(36)
  reason String @db.VarChar(500)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  user User @relation("EmailAssistanceTarget", fields: [userId], references: [id], onDelete: Restrict)
  creator User @relation("EmailAssistanceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@index([userId, revokedAt, consumedAt, expiresAt], map: "email_assistances_user_state_idx")
  @@map("email_assistances")
}
model EmailExemption {
  id String @id @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  reason String @db.VarChar(500)
  createdByUserId String @map("created_by_user_id") @db.Char(36)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  revokedByUserId String? @map("revoked_by_user_id") @db.Char(36)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  user User @relation("EmailExemptionTarget", fields: [userId], references: [id], onDelete: Restrict)
  creator User @relation("EmailExemptionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revoker User? @relation("EmailExemptionRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  @@index([userId, revokedAt, expiresAt], map: "email_exemptions_user_state_idx")
  @@map("email_exemptions")
}


// 报名建档通知：不存正文或密码；状态与建档独立。
model AccountNotification {
  id                String @id @db.Char(36)
  kind              String @db.VarChar(32)
  provisionId       String @map("provision_id") @db.Char(36)
  applicationId     String @map("application_id") @db.Char(36)
  userId            String @map("user_id") @db.Char(36)
  recipientEmail    String @map("recipient_email") @db.VarChar(191)
  qqNormalized      String @map("qq_normalized") @db.VarChar(32)
  credentialCreated Boolean @map("credential_created")
  credentialVersion Int @map("credential_version")
  status            String @db.VarChar(16)
  attemptCount      Int @default(0) @map("attempt_count")
  roundAttemptCount Int @default(0) @map("round_attempt_count")
  nextAttemptAt     DateTime @map("next_attempt_at") @db.DateTime(3)
  claimId           String? @map("claim_id") @db.Char(36)
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.DateTime(3)
  lastAttemptAt     DateTime? @map("last_attempt_at") @db.DateTime(3)
  lastErrorCode     String? @map("last_error_code") @db.VarChar(64)
  acceptedAt        DateTime? @map("accepted_at") @db.DateTime(3)
  messageId         String? @map("message_id") @db.VarChar(191)
  createdAt         DateTime @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  provision         AccountProvision @relation(fields: [provisionId], references: [id], onDelete: Restrict)
  application       JoinApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provisionId, kind], map: "account_notifications_provision_kind_uq")
  @@index([status, nextAttemptAt], map: "account_notifications_due_idx")
  @@index([status, leaseExpiresAt], map: "account_notifications_lease_idx")
  @@index([applicationId], map: "account_notifications_application_idx")
  @@index([userId], map: "account_notifications_user_idx")
  @@map("account_notifications")
}

/// Narrow management integration: successful outcomes are committed atomically with activity writes.
model BotOperation {
  principalId   String   @map("principal_id") @db.VarChar(64)
  operationId   String   @map("operation_id") @db.Char(36)
  requestDigest String   @map("request_digest") @db.Char(64)
  result        Json
  requestId     String   @map("request_id") @db.VarChar(80)
  requestedBy   String   @map("requested_by") @db.VarChar(64)
  createdAt     DateTime @map("created_at") @db.DateTime(3)

  @@id([principalId, operationId])
  @@index([createdAt], map: "bot_operations_created_idx")
  @@map("bot_operations")
}
